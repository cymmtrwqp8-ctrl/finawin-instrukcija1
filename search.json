---
layout: null
---
[
{% assign docs = site.docs | sort: "order" %}
{% assign current_group = 0 %}
{% for doc in docs %}
  {% if doc.level == 1 %}{% assign current_group = doc.order %}{% endif %}
  {
    "title": {{ doc.title | jsonify }},
    "module": {{ doc.module | jsonify }},
    "section": {{ current_group | jsonify }},
    "url": {{ doc.url | relative_url | jsonify }},
    "content": {{ doc.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
